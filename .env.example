# Supabase Auth uses the public anon/publishable key in the browser. Never put the secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Local backend profile API. For same-origin production hosting, this may be left blank.
VITE_AUTH_API_URL=http://localhost:4000
