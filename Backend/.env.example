NODE_ENV=development
PORT=4000
JSON_BODY_LIMIT=20kb

# Supabase Auth is used for passwords, sessions, email confirmation, and recovery.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# The backend profile repository can use Supabase Data API or direct PostgreSQL.
# If using postgres, DATABASE_URL must connect to the same Supabase project database
# where the auth.users profile trigger is installed.
DATABASE_PROVIDER=supabase
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
DATABASE_URL=postgresql://postgres:password@localhost:5432/official_website
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
