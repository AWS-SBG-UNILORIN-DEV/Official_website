NODE_ENV=development
PORT=4000

# PostgreSQL connection string for the database containing the auth schema.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/official_website
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
JSON_BODY_LIMIT=20kb

# Generate a random secret of at least 32 characters for local development.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_ISSUER=official-website-api
ACCESS_TOKEN_AUDIENCE=official-website
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_MINUTES=60
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# Auth endpoint rate limits within AUTH_RATE_LIMIT_WINDOW_MS.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_SIGNUP_RATE_LIMIT=10
AUTH_SIGNIN_RATE_LIMIT=5
AUTH_RECOVERY_RATE_LIMIT=5

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# SMTP settings used to send email verification and password reset links.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="AWS Student Builders Group <no-reply@localhost>"
