NODE_ENV=production
PORT=4000

# Use production database credentials and require TLS.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
JSON_BODY_LIMIT=20kb

# Replace with a unique random secret (for example: openssl rand -base64 48).
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_ISSUER=official-website-api
ACCESS_TOKEN_AUDIENCE=official-website
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_VERIFICATION_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_MINUTES=60
BCRYPT_SALT_ROUNDS=12

# Keep Secure enabled when testing in production.
AUTH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_SECURE=true

# Set this only to the number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=1
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_SIGNUP_RATE_LIMIT=10
AUTH_SIGNIN_RATE_LIMIT=5
AUTH_RECOVERY_RATE_LIMIT=5

PUBLIC_APP_URL=https://awssbgunilorin.com
CORS_ORIGINS=https://awssbgunilorin.com

# Supply production SMTP credentials through the deployment secret manager.
SMTP_HOST=SMTP_HOSTNAME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM="AWS Student Builders Group <no-reply@awssbgunilorin.com>"
